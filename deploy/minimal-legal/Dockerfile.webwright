# Jeden Playwright worker. Używaj tylko na prywatnej sieci kontenerowej.
# Wersję Playwright/Pythona zweryfikować podczas staging build.
FROM mcr.microsoft.com/playwright/python:v1.56.0-noble
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY vendor/webwright_legal_pl ./vendor/webwright_legal_pl
# legal-cite-pl w osobnym workerze. --no-deps omija jego mcp<2,
# niezgodne z FastMCP 3. Pin eli2md do commita wskazanego przez autora.
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils git && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir ".[asgi]" \
    "playwright==1.56.0" "pypdf>=5,<7" "httpx>=0.27,<0.29" \
    "eli2md @ git+https://github.com/PolskiAgentW/eli2md@4fc3ce71c94cb7a7da71e85259c50fad519af3ea"
RUN python -m pip install --no-cache-dir --no-deps \
    "git+https://github.com/apiotrowski-afk/legal-cite-pl@2c4b7bf6e2af56b42b8b87a9bdbfe93d8078c988"
RUN python -c "import eli2md.pdf, eli2md.tree; from legal_cite import pdf_tj; assert pdf_tj.wersja_pdftotext()"
RUN mkdir -p /data/webwright && chmod -R 0770 /data
EXPOSE 8000
CMD ["uvicorn", "prawo_pl_mcp.webwright_asgi:app", "--host", "0.0.0.0", "--port", "8000"]
